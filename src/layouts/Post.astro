---
import Base from './Base.astro';
import '../styles/prose.css';
import { url } from '../lib/url';
import { ymd, tagLabel, type Post as PostEntry } from '../lib/content';

interface Props { post: PostEntry; minutes: number }
const { post, minutes } = Astro.props;
const { title, summary, date, author, tags } = post.data;
---
<Base title={title} description={summary}>
  <main id="main" class="wrap post">
    <a class="back" href={url('/blog/')}>← Blog</a>
    <article data-pagefind-body>
      <header>
        <p class="meta dim" data-pagefind-ignore>
          <time datetime={date.toISOString()}>{ymd(date)}</time> · {author} · {minutes} min read
        </p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
        {tags.length > 0 && (
          <p class="tags" data-pagefind-ignore>{tags.map((t) => <a href={url(`/blog/tags/${t}/`)}>#{tagLabel(t)}</a>)}</p>
        )}
      </header>
      <div class="prose"><slot /></div>
    </article>
  </main>
</Base>
<style>
  .post { max-width: 760px; padding-top: 48px; }
  .back { font-size: 12.5px; color: var(--ink-3); }
  .back:hover { color: var(--accent); }
  header { margin: 28px 0 40px; padding-bottom: 28px; border-bottom: 1px solid var(--rule); }
  .meta { font-family: var(--font-mono); font-size: 12px; margin: 0; }
  h1 { font-size: clamp(24px, 4vw, 32px); line-height: 1.2; letter-spacing: -0.03em; font-weight: 600; margin: 10px 0 14px; }
  .lede { color: var(--ink-2); margin: 0; }
  .tags { font-family: var(--font-mono); display: flex; gap: 10px; margin: 16px 0 0; font-size: 12px; }
  .tags a { color: var(--accent-ink); }
</style>
