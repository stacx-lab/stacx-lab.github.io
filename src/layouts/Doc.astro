---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import '../styles/prose.css';
import type { MarkdownHeading } from 'astro';
import type { Doc as DocEntry } from '../lib/content';
import { docHref } from '../lib/content';
import { site } from '../config';

interface Props {
  docs: DocEntry[];
  entry?: DocEntry;
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  current?: string;
  searchable?: boolean;
}
const { docs, entry, title, description, headings = [], current, searchable = true } = Astro.props;
const i = entry ? docs.findIndex((d) => d.id === entry.id) : -1;
const prev = i > 0 ? docs[i - 1] : undefined;
const next = i >= 0 && i < docs.length - 1 ? docs[i + 1] : undefined;
const sourceUrl = (p: string) => `${site.repo}/blob/v${site.version}/${p}`;
---
<Base title={title} description={description} bodyClass="docs-page">
  <div class="docs wrap">
    <button class="menu" type="button" data-menu aria-expanded="false" aria-controls="docs-side">☰ Menu <span class="dim">/ {entry?.data.group ?? 'Docs'}</span></button>
    <aside class="col-side" id="docs-side"><Sidebar docs={docs} current={entry?.id ?? current} /></aside>

    <main id="main" class="col-main">
      <article data-pagefind-body={searchable ? '' : undefined}>
        <header class="dh">
          {entry && <p class="kicker" data-pagefind-ignore>{entry.data.group}</p>}
          <h1>{title}</h1>
          {description && <p class="lede">{description}</p>}
        </header>
        <div class="prose"><slot /></div>
      </article>

      {entry && (
        <footer class="df" data-pagefind-ignore>
          {entry.data.sources.length > 0 && (
            <p class="src">
              <span class="dim">Sources @ v{site.version}:</span>
              {entry.data.sources.map((s) => <a href={sourceUrl(s)} rel="noopener">{s}</a>)}
            </p>
          )}
          <p class="edit"><a href={`${site.editBase}docs/${entry.id}.${entry.filePath?.endsWith('.mdx') ? 'mdx' : 'md'}`} rel="noopener">Edit this page ↗</a></p>
          <nav class="pn" aria-label="pagination">
            {prev ? <a class="p" href={docHref(prev)}><span class="dim">← Previous</span>{prev.data.label ?? prev.data.title}</a> : <span />}
            {next && <a class="n" href={docHref(next)}><span class="dim">Next →</span>{next.data.label ?? next.data.title}</a>}
          </nav>
        </footer>
      )}
    </main>

    <aside class="col-toc"><div class="sticky"><Toc headings={headings} /></div></aside>
  </div>
</Base>

<script>
  // heading anchors
  document.querySelectorAll<HTMLElement>('.prose :is(h2,h3,h4)[id]').forEach((h) => {
    const a = document.createElement('a');
    a.className = 'anchor'; a.href = `#${h.id}`; a.textContent = '#'; a.ariaLabel = 'Link to section';
    h.append(a);
  });
  // code blocks: language label + copy
  document.querySelectorAll<HTMLPreElement>('.prose pre.astro-code').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code';
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = pre.dataset.language && pre.dataset.language !== 'plaintext' ? pre.dataset.language : 'text';
    bar.innerHTML = `<span>${lang}</span><button type="button" class="copy-btn">Copy</button>`;
    pre.replaceWith(wrap);
    wrap.append(bar, pre);
    const btn = bar.querySelector('button')!;
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, '')); btn.textContent = 'Copied'; }
      catch { btn.textContent = 'Failed'; }
      setTimeout(() => (btn.textContent = 'Copy'), 1400);
    });
  });
  // wide tables scroll
  document.querySelectorAll('.prose table').forEach((t) => {
    const w = document.createElement('div'); w.className = 'table-wrap'; t.replaceWith(w); w.append(t);
  });
  // mobile drawer
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  btn.addEventListener('click', () => {
    const open = document.body.classList.toggle('side-open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .docs {
    display: grid; grid-template-columns: 220px minmax(0, 1fr) 200px; gap: 48px;
    max-width: 1240px;
  }
  .col-side {
    position: sticky; top: var(--topbar); align-self: start;
    max-height: calc(100vh - var(--topbar)); overflow-y: auto; padding: 24px 0 40px;
    scrollbar-width: thin;
  }
  .col-main { padding: 28px 0 72px; min-width: 0; max-width: 760px; }
  .col-toc .sticky { position: sticky; top: calc(var(--topbar) + 28px); padding-top: 28px; }
  .menu { display: none; }

  .dh { margin-bottom: 24px; }
  .dh h1 { font-size: 26px; line-height: 1.2; letter-spacing: -0.02em; font-weight: 600; margin: 4px 0 8px; }
  .lede { color: var(--ink-2); margin: 0; font-size: 15px; }

  .df { margin-top: 48px; border-top: 1px solid var(--rule); padding-top: 18px; font-size: 12px; }
  .src { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0 0 8px; }
  .src a, .edit a { color: var(--ink-2); }
  .src a:hover, .edit a:hover { color: var(--accent); }
  .edit { margin: 0 0 24px; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pn a { display: grid; gap: 4px; padding: 10px 14px; border: 1px solid var(--rule); border-radius: var(--radius); font-size: 13.5px; }
  .pn a:hover { border-color: var(--accent); }
  .pn .n { text-align: right; grid-column: 2; }
  .pn .dim { font-size: 11.5px; }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: 210px minmax(0, 1fr); gap: 44px; }
    .col-toc { display: none; }
  }
  @media (max-width: 820px) {
    .docs { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .menu {
      display: block; position: sticky; top: var(--topbar); z-index: 30; width: calc(100% + 32px); margin: 0 -16px;
      text-align: left; font: inherit; font-size: 12.5px; padding: 10px 16px; cursor: pointer;
      background: var(--bg); color: var(--ink); border: 0; border-bottom: 1px solid var(--rule);
    }
    .col-side {
      display: none; position: fixed; inset: calc(var(--topbar) + 41px) 0 0 0; z-index: 30;
      max-height: none; background: var(--bg); padding: 20px 16px 48px;
    }
    :global(body.side-open) .col-side { display: block; }
    :global(body.side-open) { overflow: hidden; }
    .col-main { padding-top: 28px; }
    .pn { grid-template-columns: 1fr; }
    .pn .n { grid-column: 1; }
  }
</style>
