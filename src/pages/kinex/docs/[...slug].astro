---
import KinexRedirect from '../../../layouts/KinexRedirect.astro';
import { getDocs, docSlug } from '../../../lib/content';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((entry) => ({ params: { slug: docSlug(entry) } }));
}

const { slug } = Astro.params;
---
<KinexRedirect path={slug ? `/docs/${slug}/` : '/docs/'} />
