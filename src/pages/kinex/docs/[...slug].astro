---
import Doc from '../../../layouts/Doc.astro';
import { render } from 'astro:content';
import { getDocs, docSlug, type Doc as DocEntry } from '../../../lib/content';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((entry) => ({ params: { slug: docSlug(entry) }, props: { entry, docs } }));
}

interface Props { entry: DocEntry; docs: DocEntry[] }
const { entry, docs } = Astro.props;
const { Content, headings } = await render(entry);
---
<Doc docs={docs} entry={entry} title={entry.data.title} description={entry.data.description} headings={headings}>
  <Content />
</Doc>
