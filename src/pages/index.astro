---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import CopyCmd from '../components/CopyCmd.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { site } from '../config';
import { url } from '../lib/url';
const paths = [
  { k: 'Play with simulators', cmd: 'roboenv setup', body: 'RoboEnv exposes simulated robots as Kinex devices, with the same interfaces as real hardware.', href: '/docs/simulators/' },
  { k: 'Work with real robots', cmd: '/onboarding', body: 'Describe the hardware and the task. Kinex connects the devices and calibrates what the task needs.', href: '/docs/real-robots/' },
];
---
<Base>
  <main id="main">
    <section class="hero grid-bg">
      <div class="wrap hero-in">
        <div class="pitch">
          <h1>A robotics harness<br />for coding agents<span class="caret">_</span></h1>
          <p class="sub">
            Give a coding agent <b>devices</b>, <b>tools</b> and <b>skills</b>, and it works with robots the way it
            works with code: see through cameras, move arms and run tasks, in simulation or on real hardware.
          </p>
          <CopyCmd cmd={site.install} />
          <p class="platform-note">Install on macOS and Ubuntu.</p>
          <div class="cta">
            <a class="btn primary" href={url('/docs/')}>Get started →</a>
            <a class="btn" href="#gallery">Watch the demos ↓</a>
            <a class="btn" href={url('/blog/')}>Read the blog</a>
            <a class="btn" href={site.repo} rel="noopener">GitHub ↗</a>
          </div>
        </div>
        <Terminal />
      </div>
    </section>

    <VideoGallery />

    <section class="wrap sec">
      <p class="kicker">02 · Architecture</p>
      <h2>Three layers. One loop.</h2>
      <ArchDiagram />
    </section>

    <section class="wrap sec">
      <p class="kicker">03 · Where to start</p>
      <div class="cards">
        {paths.map((p) => (
          <a class="card" href={url(p.href)}>
            <span class="ck">{p.k}</span>
            <code class="cc">{p.cmd}</code>
            <span class="cb">{p.body}</span>
            <span class="go">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero-in {
    display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 36px;
    align-items: center; padding-block: 64px 72px;
  }
  @media (max-width: 960px) { .hero-in { grid-template-columns: minmax(0, 1fr); padding-block: 48px 56px; gap: 40px; } }
  .pitch { min-width: 0; }
  h1 { font-size: clamp(38px, 4.2vw, 62px); line-height: 1.08; letter-spacing: -0.035em; font-weight: 600; margin: 0 0 18px; }
  .caret { color: var(--accent); animation: blink 1.1s steps(1) infinite; margin-left: 2px; }
  @keyframes blink { 50% { opacity: 0; } }
  .sub { color: var(--ink-2); max-width: 46ch; margin: 0 0 26px; }
  .sub b { color: var(--ink); font-weight: 600; }
  .platform-note { margin: 8px 0 0; font-size: var(--fs-1); color: var(--ink-2); }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }

  .sec { padding-top: 72px; }
  .sec h2 { font-size: var(--fs-4); letter-spacing: -0.02em; font-weight: 600; margin: 6px 0 24px; }

  .cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 18px; border: 1px solid var(--rule); border-radius: 6px; }
  @media (max-width: 860px) { .cards { grid-template-columns: 1fr; } }
  .card { position: relative; display: grid; gap: 10px; align-content: start; padding: 18px 20px 22px; background: var(--panel); }
  .card + .card { border-left: 1px solid var(--rule); }
  @media (max-width: 860px) { .card + .card { border-left: 0; border-top: 1px solid var(--rule); } }
  .card:first-child { border-radius: 6px 0 0 6px; } .card:last-child { border-radius: 0 6px 6px 0; }
  .ck { font-family: var(--font-head); font-weight: 700; font-size: 17px; }
  .cc { font-size: 12px; color: var(--accent-ink); }
  .cc::before { content: '$ '; color: var(--ink-3); }
  .cb { font-size: 14.5px; color: var(--ink-2); line-height: 1.6; }
  .go { position: absolute; top: 22px; right: 22px; color: var(--ink-3); transition: transform .15s; }
  .card:hover { background: var(--bg); }
  .card:hover .go { color: var(--accent); transform: translateX(4px); }

</style>
