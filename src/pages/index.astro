---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
---
<Base description="Explore Kinex and the STACX Lab blog." section="lab">
  <main id="main" class="wrap home">
    <header class="grid-bg intro">
      <p class="kicker">Agents · Robotics · Systems</p>
      <h1>STACX Lab</h1>
      <p>Our projects and ideas.</p>
    </header>
    <div class="destinations">
      <a class="destination" href="/kinex/">
        <span class="kicker">Project</span>
        <h2><Wordmark size={30} /></h2>
        <p>A general harness that connects coding agents to any physical robot.</p>
        <span class="go">Explore Kinex →</span>
      </a>
      <a class="destination" href="/blog/">
        <span class="kicker">Writing</span>
        <h2>Blog</h2>
        <p>Notes on agents, robotics, and the systems we build.</p>
        <span class="go">Read the blog →</span>
      </a>
    </div>
  </main>
</Base>
<style>
  .home { max-width: 1040px; min-height: calc(100vh - 125px); padding-bottom: 80px; }
  .intro { padding-block: 80px 48px; border-bottom: 1px solid var(--rule); }
  h1 { font-size: var(--fs-5); line-height: 1.1; letter-spacing: -.025em; margin: 16px 0 20px; }
  .intro > p:last-child { font-size: 21px; color: var(--ink-2); margin: 0; }
  .destinations { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 32px; }
  .destination { padding: 28px; background: var(--panel); border: 1px solid var(--rule); border-radius: var(--radius); display: flex; flex-direction: column; align-items: start; }
  .destination:hover { border-color: var(--accent); }
  h2 { font-size: 30px; line-height: 1.3; margin: 20px 0 12px; }
  .destination p { margin: 0 0 24px; color: var(--ink-2); max-width: 38ch; }
  .go { color: var(--accent-ink); font-size: 14px; margin-top: auto; }
  @media (max-width: 640px) { .intro { padding-block: 48px 32px; } .destinations { grid-template-columns: 1fr; } }
</style>
