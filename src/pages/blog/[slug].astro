---
import Post from '../../layouts/Post.astro';
import { render } from 'astro:content';
import { getPosts, type Post as PostEntry } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: PostEntry };
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).length / 220));
---
<Post post={post} minutes={minutes}><Content /></Post>
