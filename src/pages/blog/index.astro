---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagLabel } from '../../lib/content';
import { url } from '../../lib/url';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="Blog" description="Release notes, design notes and field reports from the Kinex team.">
  <main id="main" class="wrap blog">
    <header>
      <p class="kicker">Blog</p>
      <h1>Release notes, design notes, field reports.</h1>
      <p class="filters">
        <a class="on" href={url('/blog/')}>All</a>
        {tags.map((t) => <a href={url(`/blog/tags/${t}/`)}>#{tagLabel(t)}</a>)}
        <a class="rss" href={url('/rss.xml')}>RSS ↗</a>
      </p>
    </header>
    <PostList posts={posts} />
  </main>
</Base>
<style>
  .blog { max-width: 900px; padding-top: 56px; }
  header { margin-bottom: 36px; }
  h1 { font-size: clamp(22px, 3.4vw, 30px); letter-spacing: -0.03em; font-weight: 600; margin: 10px 0 18px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; margin: 0; }
  .filters a { padding: 2px 8px; border: 1px solid var(--rule); border-radius: 3px; color: var(--ink-2); }
  .filters a:hover, .filters a.on { border-color: var(--ink); color: var(--ink); }
  .filters .rss { margin-left: auto; border-color: transparent; }
</style>
