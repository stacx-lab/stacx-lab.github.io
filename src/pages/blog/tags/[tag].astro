---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts, tagLabel, type Post } from '../../../lib/content';
import { url } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Post[] };
---
<Base title={`#${tagLabel(tag!)}`}>
  <main id="main" class="wrap blog">
    <a class="back" href={url('/blog/')}>← All posts</a>
    <h1>#{tagLabel(tag!)} <span class="dim">{posts.length}</span></h1>
    <PostList posts={posts} />
  </main>
</Base>
<style>
  .blog { max-width: 900px; padding-top: 48px; }
  .back { font-size: 12.5px; color: var(--ink-3); }
  h1 { font-size: 26px; font-weight: 600; margin: 18px 0 28px; }
</style>
