---
import { benchmarkScopes } from '../data/benchmark';

interface Props {
  metric: 'success' | 'cost';
  pending?: boolean;
}
const { metric, pending = false } = Astro.props;
const success = metric === 'success';
const title = success ? 'Task success rate' : 'Average cost per task';
const max = success ? 100 : 6;
const ticks = success ? ['0', '25', '50', '75', '100%'] : ['$0', '$1.50', '$3', '$4.50', '$6'];
---

<figure class="chart">
  <figcaption>
    <h4>{title}</h4>
    <span>{success ? 'Higher is better' : 'USD · lower is better'}</span>
  </figcaption>
  {pending ? (
    <div class="pending" aria-label={`${title}: results not yet available`}>
      <span>Results forthcoming</span>
    </div>
  ) : benchmarkScopes.map((scope) => (
    <div class="plot" data-scope-panel={scope.id} hidden={scope.id !== 'average'}>
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="y-axis" aria-hidden="true">
        {ticks.map((tick, index) => <span style={`bottom: ${index * 25}%`}>{tick}</span>)}
      </div>
      {scope.settings.map((setting) => {
        const value = success ? setting.successes / scope.tasks * 100 : setting.cost / scope.tasks;
        const label = success ? `${value.toFixed(1)}%` : `$${value.toFixed(2)}`;
        return (
          <div class="column">
            <div class="track">
              <div class={`bar ${setting.id}`} style={`height: ${value / max * 100}%`}>
                <span class="value">{label}<span class="sr-only">{success ? ` (${setting.successes} of ${scope.tasks} tasks)` : ''}</span></span>
              </div>
            </div>
            <span class="setting">{setting.label}</span>
          </div>
        );
      })}
    </div>
  ))}
</figure>

<style>
  .chart { margin: 0; padding: 20px; border: 1px solid var(--rule); border-radius: 6px; background: var(--panel); }
  figcaption { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 20px; }
  h4 { margin: 0; font-size: 16px; font-weight: 600; }
  figcaption > span { color: var(--ink-2); font-size: 12px; }
  .plot, .pending { height: 264px; }
  .plot { position: relative; display: grid; grid-template-columns: 44px repeat(3, minmax(0, 1fr)); padding-top: 8px; }
  .plot[hidden] { display: none; }
  .grid-lines { position: absolute; left: 44px; right: 0; top: 8px; height: 200px; border-block: 1px solid var(--rule); background: repeating-linear-gradient(to top, transparent 0, transparent calc(25% - 1px), var(--rule) calc(25% - 1px), var(--rule) 25%); }
  .y-axis { position: relative; height: 200px; border-right: 1px solid var(--rule-2); }
  .y-axis span { position: absolute; right: 8px; transform: translateY(50%); color: var(--ink-2); font-size: 11px; }
  .column { position: relative; min-width: 0; text-align: center; }
  .track { height: 200px; display: flex; justify-content: center; align-items: flex-end; border-bottom: 1px solid var(--rule-2); }
  .bar { position: relative; width: 52%; max-width: 64px; border-radius: 3px 3px 0 0; }
  .setting { display: block; max-width: 125px; margin-inline: auto; padding: 10px 3px 0; font-size: 12px; line-height: 1.3; }
  .control { background: #b58b6a; }
  .device { background: #71899a; }
  .kinex { background: var(--accent); }
  .value { position: absolute; bottom: calc(100% + 6px); left: 50%; transform: translateX(-50%); white-space: nowrap; font-size: 13px; font-variant-numeric: tabular-nums; }
  .pending { display: grid; place-items: center; border: 1px dashed var(--rule); border-radius: 3px; color: var(--ink-3); font-size: 13px; }
  @media (max-width: 600px) {
    .chart { padding: 16px 12px; }
    .value { font-size: 12px; }
    .setting { font-size: 11px; }
    figcaption > span { font-size: 11px; }
  }
</style>
