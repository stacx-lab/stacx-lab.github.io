---
import data from '../data/hero-terminal.json';
import { url } from '../lib/url';
type Step = {
  id: string; kind: string; duration: number; text?: string; title?: string;
  detail?: string; result?: string; code?: string;
  outcome?: string; busy?: number;
  views?: { image: string; alt: string; camera: string; label: string }[];
};
const steps: Step[] = data.steps;
---
<figure class="demo">
  <div class="term" data-term data-shell-duration={data.shellDuration}>
    <div class="chrome">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="title">Kinex</span>
      <div class="controls">
        <button type="button" data-pause hidden>Pause</button>
        <button type="button" data-replay hidden aria-label="Replay Kinex demo">↻ Replay</button>
      </div>
    </div>
    <div class="body">
      <div class="shell" data-shell aria-label="Environment setup commands">
        <div class="shell-label">RoboEnv <span>~/lab</span></div>
        {data.shell.map(line => (
          <div class:list={['shell-line', line.kind]} data-line>
            <span class="prompt" aria-hidden="true">{line.kind === 'sh' ? '$' : ''}</span>
            <span data-text>{line.text}</span>
          </div>
        ))}
      </div>
      <div class="session" data-session aria-label="Kinex session">
        <div class="session-header"><b>Kinex</b><span>· robotics coding agent</span></div>
        <div class="conversation" data-conversation tabindex="0" aria-label="Session transcript">
          {steps.map(step => (
            <div class="entry" data-step={step.id} data-kind={step.kind} data-duration={step.duration} data-outcome={step.outcome || 'success'} data-busy={step.busy || 180}>
              {step.kind === 'user' && <div class="user-message" data-stream>{step.text}</div>}
              {step.kind === 'agent' && <div class="agent-message" data-stream>{step.text}</div>}
              {['tool', 'code', 'image'].includes(step.kind) && (
                <div class="tool" data-tool data-state={step.outcome || 'success'}>
                  <div class="tool-title"><b>{step.title}</b> <span data-detail>{step.detail}</span><span class="tool-state" data-tool-state>{step.outcome === 'error' ? '!' : '✓'}</span></div>
                  {step.result && <div class="result" data-result data-stream>{step.result}</div>}
                  {step.code && <pre class="code" data-result><code data-stream>{step.code}</code></pre>}
                  {step.views && <div class:list={['views', { paired: step.views.length > 1 }]} data-result>
                    {step.views.map(view => <figure class="camera-view">
                      <img src={url(view.image)} alt={view.alt} width="640" height="480" loading="eager" decoding="async" />
                      <figcaption>{view.camera} · {view.label}</figcaption>
                    </figure>)}
                  </div>}
                </div>
              )}
            </div>
          ))}
        </div>
        <div class="session-bottom">
          <div class="editor"><span aria-hidden="true">›</span> <span data-editor></span><span class="cursor" aria-hidden="true">▍</span></div>
          <div class="session-footer"><span>~/lab/workspace</span><span>Kinex · ask</span></div>
        </div>
      </div>
    </div>
    <div class="playback"><span class="status-dot" aria-hidden="true"></span><span data-status role="status">Session complete</span><span class="playback-label">Session demo</span></div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-term]').forEach(term => {
    const shell = term.querySelector<HTMLElement>('[data-shell]')!;
    const session = term.querySelector<HTMLElement>('[data-session]')!;
    const conversation = term.querySelector<HTMLElement>('[data-conversation]')!;
    const editor = term.querySelector<HTMLElement>('[data-editor]')!;
    const status = term.querySelector<HTMLElement>('[data-status]')!;
    const pause = term.querySelector<HTMLButtonElement>('[data-pause]')!;
    const replay = term.querySelector<HTMLButtonElement>('[data-replay]')!;
    const steps = [...term.querySelectorAll<HTMLElement>('[data-step]')];
    const original = new Map([...term.querySelectorAll<HTMLElement>('[data-stream], [data-detail], [data-text]')].map(el => [el, el.textContent!]));
    const lines = [...shell.querySelectorAll<HTMLElement>('[data-line]')];
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let generation = 0;
    let paused = false;
    let visible = false;
    let started = false;
    let running = false;
    let activeTime = 0;
    const follow = () => { conversation.scrollTop = conversation.scrollHeight; };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !started && !motion.matches) { started = true; void play(); }
    }, { threshold: 0.15 });

    // Only visible, unpaused playback counts toward the 30-second timeline.
    async function delay(ms: number, token: number) {
      let remaining = ms;
      while (remaining > 0) {
        if (token !== generation) return false;
        const before = performance.now();
        await new Promise(resolve => setTimeout(resolve, Math.max(4, Math.min(16, remaining))));
        if (token !== generation) return false;
        if (!paused && visible && !document.hidden) {
          const elapsed = performance.now() - before;
          remaining -= elapsed;
          activeTime += elapsed;
        }
      }
      return token === generation;
    }
    async function stream(target: HTMLElement, text: string, token: number, duration: number) {
      target.textContent = '';
      const start = activeTime;
      const characters = [...text];
      for (let i = 0; i < characters.length; i++) {
        if (!await delay(Math.max(4, start + duration * (i + 1) / characters.length - activeTime), token)) return false;
        target.textContent += characters[i];
        if (shell.contains(target)) shell.scrollTop = shell.scrollHeight;
        else follow();
      }
      return token === generation;
    }
    function complete() {
      generation++;
      running = false;
      shell.hidden = true;
      session.hidden = false;
      original.forEach((text, el) => { el.textContent = text; });
      steps.forEach(el => {
        el.hidden = false;
        const tool = el.querySelector<HTMLElement>('[data-tool]');
        const result = el.querySelector<HTMLElement>('[data-result]');
        const state = el.querySelector<HTMLElement>('[data-tool-state]');
        if (tool) tool.dataset.state = el.dataset.outcome;
        if (result) result.hidden = false;
        if (state) state.textContent = el.dataset.outcome === 'error' ? '!' : '✓';
      });
      editor.textContent = '';
      pause.hidden = true;
      status.textContent = 'Session complete';
      follow();
    }
    async function play() {
      const token = ++generation;
      activeTime = 0;
      paused = false;
      term.dataset.paused = 'false';
      running = true;
      pause.hidden = false;
      pause.textContent = 'Pause';
      pause.setAttribute('aria-label', 'Pause Kinex demo');
      shell.hidden = false;
      session.hidden = true;
      original.forEach((text, el) => { el.textContent = text; });
      steps.forEach(el => {
        el.hidden = true;
        const tool = el.querySelector<HTMLElement>('[data-tool]');
        const result = el.querySelector<HTMLElement>('[data-result]');
        const state = el.querySelector<HTMLElement>('[data-tool-state]');
        if (tool) tool.dataset.state = 'pending';
        if (result) result.hidden = true;
        if (state) state.textContent = '◌';
      });
      lines.forEach(el => { el.hidden = true; });
      editor.textContent = '';
      shell.scrollTop = 0;
      status.textContent = 'Preparing the workspace';
      const shellDuration = Number(term.dataset.shellDuration);
      const totalLength = lines.reduce((sum, el) => sum + el.querySelector('[data-text]')!.textContent!.length, 0);
      for (const line of lines) {
        line.hidden = false;
        const target = line.querySelector<HTMLElement>('[data-text]')!;
        const text = original.get(target)!;
        if (!await stream(target, text, token, shellDuration * .85 * text.length / totalLength)) return;
        if (!await delay(60, token)) return;
      }
      if (!await delay(Math.max(0, shellDuration - activeTime), token)) return;
      shell.hidden = true;
      session.hidden = false;
      conversation.scrollTop = 0;
      for (const step of steps) {
        const start = activeTime;
        const duration = Number(step.dataset.duration);
        const kind = step.dataset.kind;
        if (kind === 'user') {
          const message = step.querySelector<HTMLElement>('[data-stream]')!;
          status.textContent = 'Inside Kinex';
          if (!await stream(editor, original.get(message)!, token, duration * .75)) return;
          editor.textContent = '';
          step.hidden = false;
          follow();
        } else if (kind === 'agent') {
          const message = step.querySelector<HTMLElement>('[data-stream]')!;
          message.textContent = '';
          step.hidden = false;
          status.textContent = 'Kinex';
          if (!await stream(message, original.get(message)!, token, duration * .8)) return;
        } else {
          const tool = step.querySelector<HTMLElement>('[data-tool]')!;
          const detail = step.querySelector<HTMLElement>('[data-detail]')!;
          const state = step.querySelector<HTMLElement>('[data-tool-state]')!;
          const result = step.querySelector<HTMLElement>('[data-result]')!;
          detail.textContent = '';
          step.hidden = false;
          follow();
          status.textContent = `${step.querySelector('b')!.textContent} ${original.get(detail)}`;
          if (!await stream(detail, original.get(detail)!, token, Math.min(220, duration * .2))) return;
          if (!await delay(Number(step.dataset.busy), token)) return;
          const output = step.querySelector<HTMLElement>('[data-stream]');
          if (output) output.textContent = '';
          result.hidden = false;
          if (output && !await stream(output, original.get(output)!, token, duration * .48)) return;
          follow();
          if (!await delay(40, token)) return;
          tool.dataset.state = step.dataset.outcome;
          state.textContent = step.dataset.outcome === 'error' ? '!' : '✓';
        }
        if (!await delay(Math.max(0, duration - (activeTime - start)), token)) return;
      }
      complete();
    }
    pause.addEventListener('click', () => {
      paused = !paused;
      term.dataset.paused = String(paused);
      pause.textContent = paused ? 'Resume' : 'Pause';
      pause.setAttribute('aria-label', paused ? 'Resume Kinex demo' : 'Pause Kinex demo');
    });
    replay.addEventListener('click', () => {
      if (motion.matches) { complete(); return; }
      started = true;
      void play();
    });
    motion.addEventListener('change', () => {
      if (motion.matches) { complete(); replay.hidden = true; }
      else { replay.hidden = false; if (!running && !started && visible) { started = true; void play(); } }
    });
    complete();
    replay.hidden = motion.matches;
    observer.observe(term);
    new ResizeObserver(() => { if (!running) follow(); }).observe(conversation);
  });
</script>


<style>
  .demo {
    --session-surface: #fbfaf7;
    --session-text: #262830;
    --session-border: #d9d7d0;
    --session-chrome: #efede7;
    --session-dots: #b4b0a8;
    --session-control: #62616d;
    --session-hover: #17171c;
    --session-accent: #6550a3;
    --session-muted: #727580;
    --session-dim: #606970;
    --session-scroll: #b7bab8;
    --session-user: #e4eef3;
    --session-tool: #e7edf2;
    --session-success: #e3efe5;
    --session-error: #f8e4e3;
    --session-detail: #4d626c;
    --session-state: #50758a;
    --session-ok: #287a4d;
    --session-danger: #b53c44;
    --session-result: #4c625d;
    --session-code: #365b44;
    --session-caption: #586c62;
    --session-editor: #9475cb;
    --session-playback: #606572;
    --session-status: #38835a;
    --session-label: #717784;
    --session-height: 414px;
  }
  :global([data-theme="dark"]) .demo {
    --session-surface: #17191e;
    --session-text: #dee0e1;
    --session-border: #30333b;
    --session-chrome: #202229;
    --session-dots: #555761;
    --session-control: #b5b7c2;
    --session-hover: #fff;
    --session-accent: #a798d7;
    --session-muted: #9398a2;
    --session-dim: #9da5a9;
    --session-scroll: #484e52;
    --session-user: #213b49;
    --session-tool: #2b3944;
    --session-success: #254131;
    --session-error: #5b282a;
    --session-detail: #b3bfc6;
    --session-state: #9bb6c8;
    --session-ok: #82c6a0;
    --session-danger: #ea7f81;
    --session-result: #b9c6c4;
    --session-code: #c7d9ce;
    --session-caption: #a7b5b0;
    --session-editor: #9776e5;
    --session-playback: #aeb2bd;
    --session-status: #68b78d;
    --session-label: #838995;
  }
  .demo { margin: 0; min-width: 0; }
  .term { font-family: var(--font-mono); letter-spacing: var(--tracking); background: var(--session-surface); color: var(--session-text); border: 1px solid var(--session-border); border-radius: 7px; overflow: hidden; font-size: 12px; line-height: 1.5; box-shadow: 0 18px 48px rgb(0 0 0 / 0.16); }
  .term [hidden] { display: none !important; }
  .chrome { display: flex; align-items: center; gap: 13px; padding: 0 12px; height: 38px; border-bottom: 1px solid var(--session-border); background: var(--session-chrome); }
  .dots { display: flex; gap: 5px; }
  .dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--session-dots); }
  .title { font-size: 11px; }
  .controls { display: flex; gap: 10px; margin-left: auto; }
  .controls button { font: inherit; color: var(--session-control); background: none; border: 0; padding: 4px 0; cursor: pointer; }
  .controls button:hover { color: var(--session-hover); }
  .body { min-height: var(--session-height); }
  .shell { height: var(--session-height); padding: 14px; overflow-y: auto; }
  .shell-label { color: var(--session-accent); margin-bottom: 14px; }
  .shell-label span { color: var(--session-muted); margin-left: 12px; }
  .shell-line { display: flex; gap: 8px; white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 10px; }
  .prompt { color: var(--session-accent); flex: 0 0 1ch; }
  .out { color: var(--session-dim); margin-top: 4px; }
  .session { height: var(--session-height); display: flex; flex-direction: column; }
  .session-header { display: flex; gap: 8px; padding: 7px 12px; }
  .session-header b { color: var(--session-accent); }
  .session-header span { color: var(--session-dim); }
  .conversation { flex: 1; min-height: 0; padding: 0 12px 6px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--session-scroll) transparent; }
  .entry + .entry { margin-top: 5px; }
  .user-message { background: var(--session-user); padding: 4px 7px; }
  .agent-message { line-height: 1.55; padding: 2px 0; }
  .tool { background: var(--session-tool); padding: 4px 7px; }
  .tool[data-state='success'] { background: var(--session-success); }
  .tool[data-state='error'] { background: var(--session-error); }
  .tool-title { display: flex; gap: 6px; align-items: baseline; }
  .tool-title > span:first-of-type { min-width: 0; overflow-wrap: anywhere; color: var(--session-detail); }
  .tool-state { margin-left: auto; color: var(--session-state); }
  .tool[data-state='pending'] .tool-state { display: inline-block; animation: spin .7s linear infinite; }
  .term[data-paused='true'] .tool-state { animation-play-state: paused; }
  .tool[data-state='success'] .tool-state { color: var(--session-ok); }
  .tool[data-state='error'] .tool-state { color: var(--session-danger); }
  .result { font-size: 11px; margin-top: 2px; overflow-wrap: anywhere; white-space: pre-wrap; color: var(--session-result); }
  .code { margin: 3px 0 0; font-size: 11px; white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.5; color: var(--session-code); }
  .views { display: flex; gap: 8px; margin-top: 4px; }
  .camera-view { margin: 0; min-width: 0; width: 240px; }
  .paired .camera-view { width: min(240px, calc(50% - 4px)); }
  .camera-view img { display: block; width: 100%; height: auto; border-radius: 2px; }
  .camera-view figcaption { color: var(--session-caption); font-size: 8px; padding-top: 2px; overflow-wrap: anywhere; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .session-bottom { padding: 0 12px 6px; }
  .editor { min-height: 24px; border-block: 1px solid var(--session-editor); padding: 2px 0; }
  .editor > span:first-child, .cursor { color: var(--session-accent); }
  .session-footer { display: flex; justify-content: space-between; gap: 8px; color: var(--session-muted); font-size: 9px; padding-top: 4px; }
  .playback { display: flex; align-items: center; gap: 7px; height: 28px; padding: 0 12px; border-top: 1px solid var(--session-border); color: var(--session-playback); font-size: 9px; }
  [data-status] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .status-dot { flex: 0 0 5px; height: 5px; background: var(--session-status); border-radius: 50%; }
  .playback-label { margin-left: auto; color: var(--session-label); flex-shrink: 0; }
  @media (max-width: 600px) {
    .demo { --session-height: 354px; }
    .term { font-size: 10px; }
    .chrome { gap: 8px; }
    .conversation { padding-inline: 10px; }
    .camera-view { width: 180px; }
    .result, .code { font-size: 9px; }
  }
</style>
