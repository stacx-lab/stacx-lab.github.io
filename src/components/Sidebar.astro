---
import { docGroups } from '../config';
import { url } from '../lib/url';
import { docHref, type Doc } from '../lib/content';

interface Props { docs: Doc[]; current?: string }
const { docs, current } = Astro.props;
const groups = docGroups
  .map((g) => ({ name: g, items: docs.filter((d) => d.data.group === g) }))
  .filter((g) => g.items.length);
---
<nav class="side" aria-label="docs">
  {groups.map((g) => (
    <div class="grp">
      <p class="gh"><span>{g.name}</span><span class="cnt">{g.items.length}</span></p>
      <ul>
        {g.items.map((d) => (
          <li><a href={docHref(d)} class:list={{ on: d.id === current }} aria-current={d.id === current ? 'page' : undefined}>{d.data.label ?? d.data.title}</a></li>
        ))}
      </ul>
    </div>
  ))}
  <div class="grp extra">
    <a href={url('/docs/all/')} class:list={{ on: current === '__all' }}>≡ One page</a>
  </div>
</nav>
<style>
  .side { font-size: 14.5px; }
  .grp + .grp { margin-top: 16px; }
  .gh { font-family: var(--font-mono); letter-spacing: var(--tracking); display: flex; justify-content: space-between; margin: 0 0 4px; padding: 0 10px; font-size: 11.5px; color: var(--ink-3); }
  .gh span:first-child::before { content: '// '; color: var(--accent); }
  .cnt { font-variant-numeric: tabular-nums; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { display: block; padding: 2px 10px; border-left: 1px solid var(--rule); color: var(--ink-2); line-height: 1.45; }
  a:hover { color: var(--ink); border-left-color: var(--rule-2); }
  a.on { color: var(--ink); border-left: 2px solid var(--accent); padding-left: 9px; background: var(--accent-bg); font-weight: 600; }
  .extra a { border-left-style: dashed; }
</style>
