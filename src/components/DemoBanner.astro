---
// Placeholder for the demo reel. To ship a video: <DemoBanner src="/media/reel.mp4" poster="/media/reel.jpg" />
// (files go in public/media/).
import { url } from '../lib/url';
interface Props { src?: string; poster?: string; label?: string; description?: string }
const { src, poster, label = 'Demo reel', description = 'Real arms · sims · closed-loop runs' } = Astro.props;
---
<figure class="demo">
  {src ? (
    <video src={url(src)} poster={poster && url(poster)} aria-label={label} playsinline controls preload="none"></video>
  ) : (
    <div class="ph" role="img" aria-label={`${label}: video coming soon`}>
      <div class="msg">
        <svg class="video-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="7" width="18" height="18" rx="3" />
          <path d="M21 13 L29 9 V23 L21 19" stroke-linejoin="round" />
        </svg>
        <span class="big">Video coming soon</span>
        <span class="description">{description}</span>
      </div>
    </div>
  )}
</figure>
<style>
  .demo { margin: 0; }
  video, .ph { width: 100%; border: 1px solid var(--rule); border-radius: 6px; }
  .demo video { display: block; max-width: none; aspect-ratio: 16 / 9; }
  .ph {
    display: grid; place-items: center; aspect-ratio: 21 / 9; min-height: 176px;
    padding: 24px; background: var(--bg-2); border-style: dashed;
  }
  .msg { display: grid; justify-items: center; gap: 6px; max-width: 36ch; text-align: center; }
  .video-icon { width: 32px; height: 32px; margin-bottom: 8px; color: var(--ink-2); }
  .big { font-size: var(--fs-2); font-weight: 600; }
  .description { font-size: var(--fs-1); color: var(--ink-2); line-height: 1.5; }
</style>
