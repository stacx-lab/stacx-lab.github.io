---
import { url } from '../lib/url';

// Public portrait sources are recorded in public/img/contributors/sources.json.
const groups = [
  {
    name: 'Georgia Tech',
    people: [
      { name: 'Chenxiao Gao', photo: 'chenxiao-gao.jpg', href: 'https://about.gaocx.io/' },
      { name: 'Yizhou Zhao', photo: 'yizhou-zhao.webp', href: 'https://scholar.google.com/citations?user=N7iOchIAAAAJ&hl=zh-CN' },
      { name: 'Rushi Qiang', photo: 'rushi-qiang.jpg', href: 'https://rushi-q.github.io/' },
      { name: 'Bo Dai', photo: 'bo-dai.jpg', href: 'https://bo-dai.github.io/' },
    ],
  },
  {
    name: 'Harvard',
    people: [
      { name: 'Haitong Ma', photo: 'haitong-ma.jpg', href: 'https://mahaitongdae.github.io/' },
      { name: 'Lening Li', photo: 'lening-li.jpg', href: 'https://lening.li/' },
      { name: 'Yuyang Zhang', photo: 'yuyang-zhang.jpg', href: 'https://kempnerinstitute.harvard.edu/people/our-people/yuyang-zhang/' },
      { name: 'Na Li', photo: 'na-li.jpg', href: 'https://nali.seas.harvard.edu/' },
    ],
  },
];
---

<section class="wrap contributors" id="contributors" aria-labelledby="contributors-heading">
  <h2 class="kicker" id="contributors-heading">05 · Contributors</h2>
  <div class="groups">
    {groups.map((group) => (
      <div class="group">
        <h3>{group.name}</h3>
        <ul>
          {group.people.map((person) => (
            <li>
              <a href={person.href}>
                <img src={url(`/img/contributors/${person.photo}`)} alt="" width="52" height="52" loading="lazy" decoding="async" />
                <span>{person.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .contributors { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--rule); }
  .kicker { margin: 0 0 22px; }
  .groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  h3 { margin: 0 0 16px; font-size: 15px; font-weight: 600; }
  ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; padding: 0; margin: 0; list-style: none; }
  a { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; font-size: 13px; line-height: 1.4; }
  a:hover { color: var(--accent); }
  img { width: 52px; height: 52px; object-fit: cover; object-position: center 30%; border-radius: 50%; border: 1px solid var(--rule); background: var(--panel); }
  @media (max-width: 760px) { .groups { grid-template-columns: 1fr; gap: 28px; } }
  @media (max-width: 420px) { ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; } }
</style>
