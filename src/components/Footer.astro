---
import { site } from '../config';
import { url } from '../lib/url';
import Logo from './Logo.astro';
---
<footer class="foot">
  <div class="wrap row">
    <span class="mark"><Logo size={14} /> Kinex v{site.version}</span>
    <span class="links">
      <a href={url('/docs/')}>Docs</a><i>·</i>
      <a href={url('/blog/')}>Blog</a><i>·</i>
      <a href={url('/rss.xml')}>RSS</a><i>·</i>
      <a href={site.repo} rel="noopener">GitHub</a>
    </span>
    <span class="dim">Built on the Pi coding agent · © {new Date().getFullYear()} stacx-lab</span>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--rule); margin-top: 72px; font-size: 12px; color: var(--ink-2); }
  .row { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; padding-block: 18px; }
  .mark { display: inline-flex; gap: 8px; align-items: center; color: var(--ink); }
  .links a:hover { color: var(--accent); }
  .links i { font-style: normal; color: var(--ink-3); margin: 0 8px; }
  .row > :last-child { margin-left: auto; }
  @media (max-width: 640px) { .row > :last-child { margin-left: 0; } }
</style>
