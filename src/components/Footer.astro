---
import { site } from '../config';
---

<footer class="foot" data-pagefind-ignore>
  <div class="wrap row">
    <span>Kinex is licensed under <a href={`${site.repo}/blob/main/LICENSE`}>Apache 2.0</a>.</span>
    <span class="dim">© {new Date().getFullYear()} Kinex contributors</span>
  </div>
</footer>
<style>
  .foot { border-top: 1px solid var(--rule); margin-top: 72px; font-size: 12px; color: var(--ink-2); }
  :global(.docs-page) .foot { margin-top: 0; }
  .row { display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; padding-block: 18px; }
  .row a { text-decoration: underline; text-underline-offset: 3px; }
  .row a:hover { color: var(--accent); }
  .row > :last-child { margin-left: auto; }
  @media (max-width: 640px) { .row > :last-child { margin-left: 0; } }
</style>
