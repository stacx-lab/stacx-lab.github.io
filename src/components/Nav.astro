---
import { site } from '../config';
import { url } from '../lib/url';
import Wordmark from './Wordmark.astro';
interface Props { section?: 'kinex' | 'lab' }
const { section = 'kinex' } = Astro.props;
const isKinex = section === 'kinex';
---
<header class="topbar">
  <nav class="wrap bar" aria-label="main">
    <a class="brand" href={isKinex ? url('/') : '/'} aria-label={isKinex ? 'Kinex home' : 'STACX Lab home'}>
      {isKinex ? <><Wordmark size={20} /><span class="ver">v{site.version}</span></> : <span class="lab-brand">STACX Lab</span>}
    </a>
    <div class="links">
      {isKinex ? <a class="link" href={url('/docs/')}>Docs</a> : <a class="link" href="/projects/" aria-current={Astro.url.pathname.startsWith('/projects/') ? 'page' : undefined}>Projects</a>}
      <a class="link" href="/blog/" aria-current={Astro.url.pathname.startsWith('/blog/') ? 'page' : undefined}>Blog</a>
      {isKinex && <a class="link github" href={site.repo} rel="noopener">GitHub<span class="ext">↗</span></a>}
    </div>
    <div class="tools">
      {isKinex && <button class="search-trigger" type="button" data-search-open aria-label="search">
        <span class="q">Search</span><kbd>/</kbd>
      </button>}
      <button class="theme" type="button" data-theme-toggle aria-label="toggle theme" title="Toggle theme">
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
    </div>
  </nav>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .lab-brand { font-family: var(--font-head); font-weight: 700; white-space: nowrap; }
  .link[aria-current] { color: var(--accent-ink); }
  .topbar {
    position: sticky; top: 0; z-index: 40; height: var(--topbar);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { height: 100%; display: flex; align-items: center; gap: 28px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .ver { font-family: var(--font-mono); font-size: 11px; font-weight: 400; color: var(--ink-3); border: 1px solid var(--rule); padding: 0 5px; border-radius: 3px; }
  .links { display: flex; gap: 22px; font-size: 14.5px; }
  .link { color: var(--ink-2); }
  .link:hover { color: var(--ink); }
  .ext { font-size: 10px; margin-left: 2px; color: var(--ink-3); }
  .tools { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .search-trigger {
    display: flex; align-items: center; gap: 24px; height: 30px; padding: 0 6px 0 10px;
    font: inherit; font-size: 12px; color: var(--ink-3); background: var(--panel);
    border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer;
  }
  .search-trigger:hover { border-color: var(--rule-2); color: var(--ink-2); }
  .theme {
    width: 30px; height: 30px; font: inherit; font-size: 14px; color: var(--ink-2);
    background: none; border: 1px solid transparent; border-radius: var(--radius); cursor: pointer;
  }
  .theme:hover { border-color: var(--rule); }
  :global(:root[data-theme='dark']) .sun, :global(:root[data-theme='light']) .moon { display: none; }
  @media (max-width: 640px) {
    .bar { gap: 14px; }
    .ver, .ext, .q { display: none; }
    .links { gap: 12px; }
    .search-trigger { gap: 0; padding: 0 6px; }
  }
  @media (max-width: 380px) { .github { display: none; } }
</style>
